"""Сбор собственных фото лица для дообучения модели эмоций.

Запуск:  python collect.py

Клавиши (окно с видео должно быть в фокусе):
  1 angry   2 disgust   3 fear   4 happy   5 neutral   6 sad   7 surprise
      - нажмите цифру: начнётся автосъёмка этой эмоции (несколько кадров в секунду);
        нажмите ту же цифру ещё раз, 0 или пробел: пауза
  t   - переключить набор: train (для обучения) / test (для честной проверки)
  q или Esc - выход

Снимки сохраняются только на вашем компьютере, в папку my_data/.
"""
import time
from pathlib import Path

import cv2

CLASSES = ["angry", "disgust", "fear", "happy", "neutral", "sad", "surprise"]
OUT = Path("my_data")
INTERVAL = 0.25          # секунд между снимками при автосъёмке
CAMERA_INDEX = 0

for split in ("train", "test"):
    for c in CLASSES:
        (OUT / split / c).mkdir(parents=True, exist_ok=True)


def count(split, cls):
    return len(list((OUT / split / cls).glob("*.png")))


face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)
if face_cascade.empty():
    raise SystemExit("Не удалось загрузить детектор лиц. Проверьте: pip install \"opencv-python<5\"")

cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_DSHOW)
if not cap.isOpened():
    cap = cv2.VideoCapture(CAMERA_INDEX)
if not cap.isOpened():
    raise SystemExit("Не удалось открыть камеру.")

split = "train"
active = None            # индекс активной эмоции или None
last_save = 0.0
print(__doc__)

while True:
    ok, frame = cap.read()
    if not ok:
        break
    frame = cv2.flip(frame, 1)
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(gray, scaleFactor=1.2, minNeighbors=5,
                                          minSize=(80, 80))
    face = None
    if len(faces) > 0:
        x, y, w, h = max(faces, key=lambda b: b[2] * b[3])
        face = (x, y, w, h)
        cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)

        now = time.time()
        if active is not None and now - last_save >= INTERVAL:
            crop = cv2.resize(gray[y:y + h, x:x + w], (48, 48),
                              interpolation=cv2.INTER_AREA)
            name = f"{int(now * 1000)}.png"
            cv2.imwrite(str(OUT / split / CLASSES[active] / name), crop)
            last_save = now

    # информационная панель
    status = f"set: {split.upper()}"
    if active is not None:
        status += f" | REC: {CLASSES[active]}"
    cv2.putText(frame, status, (10, 25), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                (0, 0, 255) if active is not None else (255, 255, 255), 2)
    for i, c in enumerate(CLASSES):
        color = (0, 255, 255) if i == active else (255, 255, 255)
        cv2.putText(frame, f"{i + 1} {c}: {count(split, c)}", (10, 55 + i * 22),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 1)
    if face is None:
        cv2.putText(frame, "Face not found", (10, frame.shape[0] - 15),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

    cv2.imshow("Collect (q - exit)", frame)
    key = cv2.waitKey(1) & 0xFF
    if key in (ord("q"), 27):
        break
    elif ord("1") <= key <= ord("7"):
        idx = key - ord("1")
        active = None if active == idx else idx
    elif key in (ord("0"), ord(" ")):
        active = None
    elif key == ord("t"):
        split = "test" if split == "train" else "train"
        active = None

cap.release()
cv2.destroyAllWindows()
print("Готово. Итого снимков:")
for s in ("train", "test"):
    print(" ", s, {c: count(s, c) for c in CLASSES})
