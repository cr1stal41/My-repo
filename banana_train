
import random
from pathlib import Path

import torch
import torch.nn as nn
from torch.utils.data import DataLoader, Subset
from torchvision import datasets, transforms, models
from torchvision.models import ResNet18_Weights


# Настройки
DATASET_DIR = Path("dataset")
MODEL_PATH = "banana_model.pth"
BATCH_SIZE = 16
EPOCHS = 8
IMAGE_SIZE = 224

random.seed(42)
torch.manual_seed(42)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Устройство: {device}")

if device.type == "cuda":
    print(f"Видеокарта: {torch.cuda.get_device_name(0)}")


# Преобразования для обучения с изменением изображений
train_transform = transforms.Compose([
    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),
    transforms.RandomHorizontalFlip(),
    transforms.RandomRotation(15),
    transforms.ColorJitter(
        brightness=0.2,
        contrast=0.2,
        saturation=0.2
    ),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])

# Преобразования для проверки модели
val_transform = transforms.Compose([
    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])


# Загружаем датасет
base_dataset = datasets.ImageFolder(DATASET_DIR)

print("Классы:", base_dataset.class_to_idx)
print("Всего фотографий:", len(base_dataset))

if set(base_dataset.classes) != {"banana", "not_banana"}:
    raise ValueError(
        "Создай папки dataset/banana и dataset/not_banana"
    )

# Проверяем, что оба класса содержат фотографии
for class_name, class_index in base_dataset.class_to_idx.items():
    count = sum(
        1 for _, label in base_dataset.samples
        if label == class_index
    )
    print(f"{class_name}: {count} фотографий")

    if count < 2:
        raise ValueError(
            f"В классе {class_name} слишком мало фотографий"
        )


# Разделяем данные: 80% обучение, 20% проверка
indices = list(range(len(base_dataset)))
random.shuffle(indices)

split = int(len(indices) * 0.8)
train_indices = indices[:split]
val_indices = indices[split:]

train_dataset = datasets.ImageFolder(
    DATASET_DIR,
    transform=train_transform
)

val_dataset = datasets.ImageFolder(
    DATASET_DIR,
    transform=val_transform
)

train_data = Subset(train_dataset, train_indices)
val_data = Subset(val_dataset, val_indices)

train_loader = DataLoader(
    train_data,
    batch_size=BATCH_SIZE,
    shuffle=True,
    num_workers=0
)

val_loader = DataLoader(
    val_data,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=0
)


# Загружаем ResNet18 с предобученными весами
weights = ResNet18_Weights.DEFAULT
model = models.resnet18(weights=weights)

# Замораживаем все слои
for parameter in model.parameters():
    parameter.requires_grad = False

# Разрешаем дообучать последний блок и классификатор
for parameter in model.layer4.parameters():
    parameter.requires_grad = True

model.fc = nn.Linear(
    model.fc.in_features,
    len(base_dataset.classes)
)

model = model.to(device)

criterion = nn.CrossEntropyLoss()

optimizer = torch.optim.Adam(
    filter(lambda p: p.requires_grad, model.parameters()),
    lr=0.0001
)


# Обучение
best_accuracy = 0.0

for epoch in range(EPOCHS):
    model.train()
    train_loss = 0.0

    for images, labels in train_loader:
        images = images.to(device)
        labels = labels.to(device)

        optimizer.zero_grad()

        outputs = model(images)
        loss = criterion(outputs, labels)

        loss.backward()
        optimizer.step()

        train_loss += loss.item() * images.size(0)

    train_loss /= len(train_data)

    # Проверка на фотографиях, не участвовавших в обучении
    model.eval()
    correct = 0
    total = 0

    with torch.no_grad():
        for images, labels in val_loader:
            images = images.to(device)
            labels = labels.to(device)

            outputs = model(images)
            predictions = outputs.argmax(dim=1)

            correct += (predictions == labels).sum().item()
            total += labels.size(0)

    accuracy = correct / total if total else 0

    print(
        f"Эпоха {epoch + 1}/{EPOCHS} | "
        f"Потери: {train_loss:.4f} | "
        f"Точность проверки: {accuracy * 100:.2f}%"
    )

    if accuracy > best_accuracy:
        best_accuracy = accuracy

        torch.save({
            "model_state_dict": model.state_dict(),
            "classes": base_dataset.classes,
            "class_to_idx": base_dataset.class_to_idx,
            "image_size": IMAGE_SIZE
        }, MODEL_PATH)

        print("Лучшая модель сохранена!")


print("\nОбучение завершено.")
print(f"Лучшая точность проверки: {best_accuracy * 100:.2f}%")
print(f"Модель сохранена в: {MODEL_PATH}")
