def draw_grid():

    global cell_size

    screen.delete("grid")

    if not table:
        return

    rows = len(table)
    cols = len(table[0])

    available_w = 550
    available_h = 535

    cell_size = min(
        available_w // cols,
        available_h // rows
    )

    start_x = 300 - (cols * cell_size) // 2
    start_y = 60

    for i in range(rows):

        for j in range(cols):

            x1 = start_x + j * cell_size
            y1 = start_y + i * cell_size

            x2 = x1 + cell_size - 4
            y2 = y1 + cell_size - 4

            value = table[i][j]

            if value == "":
                fill = "#061006"
                outline = DIM_GREEN
            else:
                fill = "#102910"
                outline = GREEN2

            screen.create_rectangle(
                x1,
                y1,
                x2,
                y2,
                fill=fill,
                outline=outline,
                width=2,
                tags="grid"
            )

            if value != "":

                # Тень текста
                screen.create_text(
                    (x1 + x2) / 2 + 1,
                    (y1 + y2) / 2 + 1,
                    text=value,
                    fill="#0c650c",
                    font=(
                        "Consolas",
                        max(12, cell_size // 2),
                        "bold"
                    ),
                    tags="grid"
                )

                # Основной текст
                screen.create_text(
                    (x1 + x2) / 2,
                    (y1 + y2) / 2,
                    text=value,
                    fill=GREEN,
                    font=(
                        "Consolas",
                        max(12, cell_size // 2),
                        "bold"
                    ),
                    tags="grid"
                )

            else:

                screen.create_text(
                    (x1 + x2) / 2,
                    (y1 + y2) / 2,
                    text="·",
                    fill=DARK_GREEN,
                    font=("Consolas", 18),
                    tags="grid"
                )


