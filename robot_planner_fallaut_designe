    global table
    global moves
    global current_move
    global sorting

    sorting = False

    moves = []

    current_move = 0

    table = []

    screen.delete("grid")

    status_label.config(
        text="SYSTEM READY"
    )

    step_label.config(
        text="STEP 0 / 0"
    )

    update_progress()


