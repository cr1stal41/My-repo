def create_table():

    global table
    global ROWS
    global COLS
    global EMPTY_COUNT
    global sorting
    global moves
    global current_move

    sorting = False
    moves = []
    current_move = 0

    # --------------------------------------------------------
    # ЧТЕНИЕ НАСТРОЕК
    # --------------------------------------------------------

    try:

        ROWS = int(
            rows_entry.get()
        )

        COLS = int(
            cols_entry.get()
        )

        EMPTY_COUNT = int(
            empty_entry.get()
        )

    except ValueError:

        messagebox.showerror(
            "SYSTEM ERROR",
            "ROWS, COLUMNS и EMPTY CELLS должны быть числами."
        )

        return

    total = ROWS * COLS

    if ROWS < 1 or COLS < 1:

        messagebox.showerror(
            "SYSTEM ERROR",
            "Размерность должна быть больше нуля."
        )

        return

    if EMPTY_COUNT < 1:

        messagebox.showerror(
            "SYSTEM ERROR",
            "Количество пустых ячеек должно быть больше нуля."
        )

        return

    if EMPTY_COUNT >= total:

        messagebox.showerror(
            "SYSTEM ERROR",
            "Пустых ячеек слишком много."
        )

        return

    box_count = total - EMPTY_COUNT

    # --------------------------------------------------------
    # БУКВЫ ФИО
    # --------------------------------------------------------

    letters = get_fio_letters()

    if not letters:

        messagebox.showerror(
            "SYSTEM ERROR",
            "Введите ФИО."
        )

        return

    original = letters[:]

    # --------------------------------------------------------
    # ПОВТОРЯЕМ БУКВЫ
    # --------------------------------------------------------

    while len(letters) < box_count:

        for char in original:

            letters.append(char)

            if len(letters) == box_count:
                break

    letters = letters[:box_count]

    # --------------------------------------------------------
    # ПЕРЕМЕШИВАЕМ
    # --------------------------------------------------------

    random.shuffle(letters)

    # --------------------------------------------------------
    # СОЗДАЁМ ПОЗИЦИИ
    # --------------------------------------------------------

    positions = []

    for i in range(ROWS):

        for j in range(COLS):

            positions.append(
                (i, j)
            )

    random.shuffle(positions)

    # --------------------------------------------------------
    # ТАБЛИЦА
    # --------------------------------------------------------

    table = [
        ["" for _ in range(COLS)]
        for _ in range(ROWS)
    ]

    # --------------------------------------------------------
    # ЗАПОЛНЯЕМ ЯЩИКИ
    # --------------------------------------------------------

    for k in range(box_count):

        r, c = positions[k]

        table[r][c] = letters[k]

    draw_grid()

    update_progress()

    status_label.config(
        text="SYSTEM READY"
    )

    step_label.config(
        text="STEP 0 / 0"
    )

    info_label.config(
        text=(
            f"{ROWS} × {COLS}\n"
            f"BOXES: {box_count}\n"
            f"EMPTY: {EMPTY_COUNT}"
        )
    )


# ============================================================
# СОЗДАНИЕ ЦЕЛЕВОЙ СИТУАЦИИ
# ============================================================

def create_goal():

    letters = []

    for row in table:

        for value in row:

            if value != "":
                letters.append(value)

    # --------------------------------------------------------
    # АЛФАВИТНАЯ СОРТИРОВКА
    # --------------------------------------------------------

    letters.sort(
        key=letter_number
    )

    goal = [
        ["" for _ in range(COLS)]
        for _ in range(ROWS)
    ]

    k = 0

    for i in range(ROWS):

        for j in range(COLS):

            if k < len(letters):

                goal[i][j] = letters[k]

                k += 1

    return goal


# ============================================================
# СОЗДАНИЕ ПЛАНА СОРТИРОВКИ
# ============================================================

def make_plan():

    goal = create_goal()

    work = [
        row[:]
        for row in table
    ]

    plan = []

    # --------------------------------------------------------
    # ИДЁМ СЛЕВА НАПРАВО И СВЕРХУ ВНИЗ
    # --------------------------------------------------------

    for target_row in range(ROWS):

        for target_col in range(COLS):

            wanted = goal[
                target_row
            ][
                target_col
            ]

            # Пустые клетки оставляем в конце
            if wanted == "":
                continue

            # Уже правильно
            if work[target_row][target_col] == wanted:
                continue

            # ------------------------------------------------
            # ИЩЕМ НУЖНУЮ БУКВУ
            # ------------------------------------------------

            wanted_pos = None

            for r in range(ROWS):

                for c in range(COLS):

                    # Не трогаем уже обработанные строки
                    if r < target_row:
                        continue

                    if (
                        r == target_row
                        and c < target_col
                    ):
                        continue

                    if work[r][c] == wanted:

                        wanted_pos = (
                            r,
                            c
                        )

                        break

                if wanted_pos:
                    break

            if wanted_pos is None:
                continue

            wr, wc = wanted_pos

            # ------------------------------------------------
            # ЕСЛИ ЦЕЛЕВАЯ КЛЕТКА ЗАНЯТА
            # ------------------------------------------------

            if work[target_row][target_col] != "":

                empty_pos = None

                # Ищем свободную клетку
                # среди ещё не обработанных
                for r in range(ROWS):

                    for c in range(COLS):

                        if r < target_row:
                            continue

                        if (
                            r == target_row
                            and c <= target_col
                        ):
                            continue

                        if work[r][c] == "":

                            empty_pos = (
                                r,
                                c
                            )

                            break

                    if empty_pos:
                        break

                # ------------------------------------------------
                # ЕСЛИ НЕ НАШЛИ — ИЩЕМ ЛЮБОЕ ПУСТОЕ МЕСТО
                # ------------------------------------------------

                if empty_pos is None:

                    for r in range(ROWS):

                        for c in range(COLS):

                            if work[r][c] == "":

                                empty_pos = (
                                    r,
                                    c
                                )

                                break

                        if empty_pos:
                            break

                # ------------------------------------------------
                # ПЕРЕМЕЩАЕМ СТАРУЮ БУКВУ В ПУСТУЮ КЛЕТКУ
                # ------------------------------------------------

                if empty_pos is not None:

                    er, ec = empty_pos

                    old_letter = work[
                        target_row
                    ][
                        target_col
                    ]

                    work[er][ec] = old_letter

                    work[target_row][target_col] = ""

                    plan.append(
                        (
                            old_letter,
                            (
                                target_row,
                                target_col
                            ),
                            (
                                er,
                                ec
                            )
                        )
                    )

            # ------------------------------------------------
            # ПЕРЕМЕЩАЕМ НУЖНУЮ БУКВУ
            # ------------------------------------------------

            work[target_row][target_col] = wanted

            work[wr][wc] = ""

            plan.append(
                (
                    wanted,
                    (
                        wr,
                        wc
                    ),
                    (
                        target_row,
                        target_col
                    )
                )
            )

    return plan


# ============================================================
# НАЧАТЬ СОРТИРОВКУ
# ============================================================

def start_sort():

    global moves
    global current_move
    global sorting

    if sorting:
        return

    if not table:

        messagebox.showwarning(
            "SYSTEM",
            "Сначала создайте начальную ситуацию."
        )

        return

    moves = make_plan()

    current_move = 0

    if not moves:

        status_label.config(
            text="ALREADY SORTED"
        )

        return

    sorting = True

    status_label.config(
        text="SORTING..."
    )

    step_label.config(
        text=f"STEP 0 / {len(moves)}"
    )

    update_progress()

    root.after(
        350,
        next_step
    )


# ============================================================
# СЛЕДУЮЩИЙ ШАГ
# ============================================================

def next_step():

    global current_move
    global sorting

    if current_move >= len(moves):

        sorting = False

        status_label.config(
            text="SORTING COMPLETE"
        )

        step_label.config(
            text=f"STEP {len(moves)} / {len(moves)}"
        )

        update_progress()

        return

    letter, old_pos, new_pos = moves[
        current_move
    ]

    old_row, old_col = old_pos

    new_row, new_col = new_pos

    # --------------------------------------------------------
    # ПЕРЕМЕЩЕНИЕ
    # --------------------------------------------------------

    table[new_row][new_col] = letter

    table[old_row][old_col] = ""

    current_move += 1

    # --------------------------------------------------------
    # ОБНОВЛЕНИЕ ИНТЕРФЕЙСА
    # --------------------------------------------------------

    draw_grid()

    update_progress()

    status_label.config(
        text=(
            f"MOVE BOX [{letter}]\n"
            f"{old_row + 1}:{old_col + 1}"
            f" -> "
            f"{new_row + 1}:{new_col + 1}"
        )
    )

    step_label.config(
        text=(
            f"STEP {current_move} / "
            f"{len(moves)}"
        )
    )

    root.after(
        350,
        next_step
    )


