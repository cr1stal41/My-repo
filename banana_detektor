
import tkinter as tk
from tkinter import filedialog, messagebox
from pathlib import Path

import torch
import torch.nn as nn
from PIL import Image, ImageTk, ImageOps
from torchvision import transforms


# -------------------- НАСТРОЙКИ --------------------
MODEL_PATH = Path("model.pth")
IMAGE_SIZE_FALLBACK = 128

BG = "#10151d"
PANEL = "#1b2430"
ACCENT = "#55d6a7"
TEXT = "#edf2f7"
MUTED = "#a7b3c2"
WARNING = "#ffcc80"
ERROR = "#ff8a80"

DISPLAY_NAMES = {
    "banana": "БАНАН",
    "not_banana": "НЕ БАНАН",
}
# ---------------------------------------------------


class SmallCNN(nn.Module):
    """Архитектура должна совпадать с train.py."""

    def __init__(self, num_classes):
        super().__init__()

        self.features = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3, padding=1),
            nn.BatchNorm2d(32),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2),

            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2),

            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2),

            nn.Conv2d(128, 192, kernel_size=3, padding=1),
            nn.BatchNorm2d(192),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2),

            nn.AdaptiveAvgPool2d((1, 1)),
        )

        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Dropout(0.30),
            nn.Linear(192, num_classes),
        )

    def forward(self, x):
        return self.classifier(self.features(x))


class ImageAIApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ImageAI • Банан или не банан")
        self.root.geometry("900x650")
        self.root.minsize(760, 560)
        self.root.configure(bg=BG)

        self.device = torch.device(
            "cuda" if torch.cuda.is_available() else "cpu"
        )

        self.model = None
        self.classes = []
        self.image_size = IMAGE_SIZE_FALLBACK
        self.current_photo = None

        self._build_ui()
        self._load_model()

    def _build_ui(self):
        header = tk.Frame(self.root, bg=BG)
        header.pack(fill="x", padx=28, pady=(24, 16))

        tk.Label(
            header,
            text="ImageAI",
            bg=BG,
            fg=ACCENT,
            font=("Segoe UI", 25, "bold")
        ).pack(anchor="w")

        tk.Label(
            header,
            text="Определение банана с помощью CNN-нейросети",
            bg=BG,
            fg=MUTED,
            font=("Segoe UI", 10)
        ).pack(anchor="w", pady=(3, 0))

        self.status = tk.Label(
            self.root,
            text="Проверка модели...",
            bg=PANEL,
            fg=MUTED,
            font=("Segoe UI", 10),
            anchor="w",
            padx=14,
            pady=10
        )
        self.status.pack(fill="x", padx=28, pady=(0, 16))

        body = tk.Frame(self.root, bg=BG)
        body.pack(fill="both", expand=True, padx=28, pady=(0, 20))

        body.columnconfigure(0, weight=3)
        body.columnconfigure(1, weight=2)
        body.rowconfigure(0, weight=1)

        # Панель изображения
        image_panel = tk.Frame(body, bg=PANEL, padx=16, pady=16)
        image_panel.grid(
            row=0, column=0, sticky="nsew", padx=(0, 12)
        )

        tk.Label(
            image_panel,
            text="ИЗОБРАЖЕНИЕ",
            bg=PANEL,
            fg=MUTED,
            font=("Segoe UI", 9, "bold")
        ).pack(anchor="w")

        self.image_area = tk.Label(
            image_panel,
            text="Выбери фотографию\nдля начала анализа",
            bg="#121923",
            fg=MUTED,
            font=("Segoe UI", 12),
            compound="center"
        )
        self.image_area.pack(
            fill="both", expand=True, pady=(12, 0)
        )

        # Панель результатов
        result_panel = tk.Frame(body, bg=PANEL, padx=18, pady=18)
        result_panel.grid(row=0, column=1, sticky="nsew")

        tk.Label(
            result_panel,
            text="РЕЗУЛЬТАТ АНАЛИЗА",
            bg=PANEL,
            fg=MUTED,
            font=("Segoe UI", 9, "bold")
        ).pack(anchor="w")

        self.prediction = tk.Label(
            result_panel,
            text="—",
            bg=PANEL,
            fg=TEXT,
            font=("Segoe UI", 22, "bold"),
            wraplength=250,
            justify="left"
        )
        self.prediction.pack(anchor="w", pady=(24, 6))

        self.confidence = tk.Label(
            result_panel,
            text="Уверенность модели: —",
            bg=PANEL,
            fg=ACCENT,
            font=("Segoe UI", 12, "bold")
        )
        self.confidence.pack(anchor="w", pady=(0, 14))

        # Полоса уверенности
        self.bar_bg = tk.Frame(
            result_panel, bg="#303b49", height=8
        )
        self.bar_bg.pack(fill="x", pady=(0, 20))

        self.bar = tk.Frame(
            self.bar_bg, bg=ACCENT, height=8, width=0
        )
        self.bar.place(x=0, y=0, relheight=1, width=0)

        tk.Label(
            result_panel,
            text="ВЕРОЯТНОСТИ КЛАССОВ",
            bg=PANEL,
            fg=MUTED,
            font=("Segoe UI", 9, "bold")
        ).pack(anchor="w")

        self.other_results = tk.Label(
            result_panel,
            text="После анализа здесь появятся\nвероятности обоих классов.",
            bg=PANEL,
            fg=TEXT,
            font=("Segoe UI", 10),
            justify="left",
            anchor="nw"
        )
        self.other_results.pack(
            fill="x", anchor="w", pady=(8, 18)
        )

        self.choose_button = tk.Button(
            self.root,
            text="＋  Выбрать изображение",
            command=self.choose_image,
            bg=ACCENT,
            fg="#102019",
            activebackground="#72e6bb",
            activeforeground="#102019",
            font=("Segoe UI", 11, "bold"),
            relief="flat",
            cursor="hand2",
            padx=18,
            pady=12
        )
        self.choose_button.pack(pady=(0, 24))

    def _load_model(self):
        if not MODEL_PATH.exists():
            self.status.config(
                text="Модель не найдена. Сначала запусти train.py.",
                fg=WARNING
            )
            self.choose_button.config(state="disabled")
            return

        try:
            checkpoint = torch.load(
                MODEL_PATH,
                map_location=self.device,
                weights_only=True
            )

            self.classes = checkpoint["classes"]

            if set(self.classes) != {"banana", "not_banana"}:
                raise ValueError(
                    "Нужна модель с классами banana и not_banana. "
                    "Проверь dataset и переобучи модель через train.py."
                )

            self.image_size = int(
                checkpoint.get("image_size", IMAGE_SIZE_FALLBACK)
            )

            self.model = SmallCNN(
                num_classes=len(self.classes)
            ).to(self.device)

            self.model.load_state_dict(
                checkpoint["model_state_dict"]
            )
            self.model.eval()

            if self.device.type == "cuda":
                device_text = torch.cuda.get_device_name(0)
            else:
                device_text = "CPU"

            self.status.config(
                text=f"Модель загружена • {device_text} • 2 класса",
                fg=ACCENT
            )

            self.choose_button.config(state="normal")

        except Exception as error:
            self.model = None

            self.status.config(
                text="Не удалось загрузить модель.",
                fg=ERROR
            )

            messagebox.showerror(
                "Ошибка модели",
                "Проверь файл model.pth и повторно запусти train.py.\n\n"
                f"Подробности: {error}"
            )

            self.choose_button.config(state="disabled")

    def choose_image(self):
        if self.model is None:
            messagebox.showwarning(
                "Нет модели",
                "Сначала обучи модель через train.py."
            )
            return

        file_path = filedialog.askopenfilename(
            title="Выбери изображение",
            filetypes=[
                (
                    "Изображения",
                    "*.png *.jpg *.jpeg *.bmp *.webp"
                ),
                ("Все файлы", "*.*")
            ]
        )

        if not file_path:
            return

        try:
            with Image.open(file_path) as source:
                image = ImageOps.exif_transpose(
                    source
                ).convert("RGB")

            # Показываем выбранное изображение
            preview = image.copy()
            preview.thumbnail((600, 440))

            self.current_photo = ImageTk.PhotoImage(preview)
            self.image_area.config(
                image=self.current_photo,
                text=""
            )

            # Важно: преобразование должно совпадать с train.py.
            # В train.py используется ToTensor без Normalize.
            transform = transforms.Compose([
                transforms.Resize((
                    self.image_size,
                    self.image_size
                )),
                transforms.ToTensor(),
            ])

            tensor = transform(image).unsqueeze(0).to(self.device)

            with torch.no_grad():
                logits = self.model(tensor)
                probabilities = torch.softmax(logits, dim=1)[0]

            scores, indices = torch.sort(
                probabilities, descending=True
            )

            best_index = indices[0].item()
            best_class = self.classes[best_index]
            best_score = scores[0].item() * 100

            display_class = DISPLAY_NAMES.get(
                best_class, best_class
            )

            self.prediction.config(text=display_class)
            self.confidence.config(
                text=f"Уверенность модели: {best_score:.1f}%"
            )

            # Цвет результата
            if best_score < 60:
                result_color = WARNING
            elif best_class == "banana":
                result_color = ACCENT
            else:
                result_color = TEXT

            self.prediction.config(fg=result_color)
            self.confidence.config(fg=result_color)

            self.bar.config(
                bg=WARNING if best_score < 60 else ACCENT
            )

            self.bar.place(
                x=0,
                y=0,
                relheight=1,
                width=0
            )

            # Показываем вероятности обоих классов
            lines = []

            for score, index in zip(scores, indices):
                class_name = self.classes[index.item()]
                readable_name = DISPLAY_NAMES.get(
                    class_name, class_name
                )

                lines.append(
                    f"• {readable_name}: {score.item() * 100:.1f}%"
                )

            self.other_results.config(text="\n".join(lines))

            if best_score < 60:
                status_text = (
                    "Низкая уверенность. Попробуй другое фото "
                    "с более чётким объектом."
                )
                self.status.config(
                    text=status_text,
                    fg=WARNING
                )
            else:
                self.status.config(
                    text=f"Проанализировано: {Path(file_path).name}",
                    fg=ACCENT
                )

            self.root.after(100, self._update_bar)

        except Exception as error:
            messagebox.showerror(
                "Ошибка изображения",
                "Не удалось обработать выбранный файл.\n\n"
                f"{error}"
            )

    def _update_bar(self):
        if self.model is None:
            return

        text = self.confidence.cget("text")

        try:
            percent = float(
                text.split(":")[1].strip().replace("%", "")
            )
        except (IndexError, ValueError):
            percent = 0

        width = self.bar_bg.winfo_width()

        self.bar.place(
            x=0,
            y=0,
            relheight=1,
            width=int(width * percent / 100)
        )


def main():
    root = tk.Tk()
    ImageAIApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
