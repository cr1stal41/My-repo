@app.route("/", methods=["GET", "POST"])
def index():
    result = None
    confidence = None
    detail = ""
    photo_version = 0

    if request.method == "POST":
        uploaded_file = request.files.get("photo")

        if uploaded_file is None or not uploaded_file.filename:
            return "Сначала выбери фотографию.", 400

        try:
            image_data = uploaded_file.read()

            if not image_data:
                return "Получен пустой файл.", 400

            image = Image.open(
                io.BytesIO(image_data)
            )

            image = ImageOps.exif_transpose(image).convert("RGB")

            # Сохраняем изображение для показа на телефоне
            image.save(
                PHOTO_PATH,
                format="JPEG",
                quality=95
            )

            # Запускаем распознавание
            result, confidence, detail = detect_banana(image)

            # Передаём результат окну Tkinter
            result_queue.put((
                image.copy(),
                result,
                confidence,
                detail
            ))

            photo_version = int(PHOTO_PATH.stat().st_mtime)

        except Exception:
            app.logger.exception(
                "Не удалось обработать изображение"
            )
            return (
                "Не удалось обработать изображение. "
                "Подробности находятся в консоли компьютера.",
                500
            )

    return render_template_string(
        HTML,
        result=result,
        confidence=confidence,
        detail=detail,
        photo_version=photo_version
    )


@app.route("/last-photo")
def last_photo():
