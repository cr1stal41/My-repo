def update_window():
    latest = None

    try:
        while True:
            latest = result_queue.get_nowait()
    except Empty:
        pass

    if latest is not None:
        image, result, confidence, detail = latest

        preview = image.copy()
        preview.thumbnail((450, 360))

        photo = ImageTk.PhotoImage(preview)

        image_label.configure(
            image=photo,
            text=""
        )
        image_label.image = photo

        result_label.configure(
            text=f"РЕЗУЛЬТАТ: {result}"
        )

        confidence_label.configure(
            text=f"Уверенность модели: {confidence}%"
        )

        detail_label.configure(text=detail)

        status_label.configure(
            text="Фотография получена и обработана"
        )

    root.after(200, update_window)


